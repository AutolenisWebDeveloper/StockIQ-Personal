# BullMQ worker image. Shares the same codebase/build as the web image; the
# build step emits the compiled worker to dist/ (CommonJS) so it runs under
# node directly. `tsx src/worker.ts` is an equivalent dev alternative.
FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install

COPY . .
RUN npm run build

# Compose overrides this with: node dist/worker/index.js.
CMD ["node", "dist/worker/index.js"]
