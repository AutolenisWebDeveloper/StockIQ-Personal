# StockIQ Personal — environment variables.
# Local dev (Docker Compose): copy to `.env`.
# Production (Railway): set these in each service's Variables (web + worker).
# NEVER commit real values — `.env*` is gitignored.

# ============================================================================
# DEPLOY TARGET A — Railway (web + worker) + Neon (Postgres) + Upstash (Redis)
# ============================================================================

# --- Database (Neon) -------------------------------------------------------
# Use the DIRECT (unpooled) endpoint for the long-lived web + worker servers.
# Host looks like: ep-xxx-xxx.us-east-2.aws.neon.tech  (NO -pooler).
# The pooled (-pooler) host breaks DDL/prepared statements; src/lib/db.ts
# auto-sets prepare:false if it ever detects -pooler, but DIRECT is correct.
# DATABASE_URL=postgresql://user:pass@ep-xxx-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Redis / Queue (Upstash) ----------------------------------------------
# Use the TCP+TLS endpoint (rediss://), NOT the REST URL. src/lib/redis.ts
# enables TLS + enableReadyCheck:false automatically for rediss://.
# REDIS_URL=rediss://default:pass@xxx.upstash.io:6379

# --- App -------------------------------------------------------------------
NODE_ENV=production
# Railway injects PORT; `npm run start` (next start) honors it. 3000 locally.
# NEXT_PUBLIC_APP_URL=https://your-web-service.up.railway.app

# ============================================================================
# DEPLOY TARGET B — local Docker Compose (timescaledb-ha + redis + caddy)
# ============================================================================
APP_DOMAIN=localhost
AUTH_USER=operator
AUTH_PASSWORD_HASH=               # caddy hash-password output (bcrypt)
POSTGRES_USER=stockiq
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stockiq
# Compose uses the in-network hosts; Railway uses the Neon/Upstash URLs above.
DATABASE_URL=postgres://stockiq:change-me@postgres:5432/stockiq
REDIS_URL=redis://redis:6379

# --- single-user app account (seeded; no registration) ---------------------
SEED_USER_EMAIL=you@example.com
SEED_USER_PASSWORD_HASH=          # bcrypt; app-level JWT auth lands in Phase 4
SEED_WATCHLIST_NAME=Core
SEED_TICKER=AAPL

# ============================================================================
# Data sources (Phase 1+) — required for ingestion to return real data
# ============================================================================
SEC_USER_AGENT=StockIQ Personal you@example.com   # SEC requires a descriptive UA
FRED_API_KEY=
ALPHAVANTAGE_API_KEY=             # supplementary only — never in a per-ticker loop
FINNHUB_API_KEY=                  # optional future analyst plug

# ============================================================================
# AI (Phase 3+) — embeddings + Decision Reports
# ============================================================================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ============================================================================
# Auth (Phase 4 — deferred) — replaces the Caddy gate when web is public
# ============================================================================
# JWT_SECRET=                     # openssl rand -base64 32

# ============================================================================
# Delivery (Phase 5)
# ============================================================================
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=               # optional
