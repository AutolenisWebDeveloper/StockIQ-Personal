{
  "name": "stockiq-personal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && tsc -p tsconfig.worker.json && node -e \"require('fs').writeFileSync('dist/package.json', JSON.stringify({type:'commonjs'}))\"",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "migrate": "tsx db/migrate.ts",
    "seed": "tsx db/seed.ts",
    "seed:demo": "tsx db/seed-demo.ts",
    "enqueue:initial": "tsx scripts/enqueue-initial.ts",
    "bootstrap": "npm run migrate && npm run seed && npm run enqueue:initial",
    "lint": "next lint"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5",
    "ioredis": "5.10.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.20.0",
    "next": "^15",
    "openai": "^6.44.0",
    "postgres": "^3",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10",
    "postcss": "^8",
    "tailwindcss": "^3",
    "tsx": "^4",
    "typescript": "^5"
  }
}
